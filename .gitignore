.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data (tracked via DVC)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# MLflow local store
mlruns/
mlartifacts/

